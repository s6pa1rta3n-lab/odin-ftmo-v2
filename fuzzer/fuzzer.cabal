cabal-version: 3.0
name: fuzzer
version: 0.1.0.0
synopsis: Haskell QuickCheck property fuzzer for FTMO formal verification model
build-type: Custom

custom-setup
  setup-depends:
    base,
    Cabal

library
  exposed-modules:
    Types
    Model
    Generator
    Properties
  build-depends:
    base >= 4.14 && < 5,
    QuickCheck >= 2.14,
    containers
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -Wall -Wno-orphans -O2

test-suite fuzzer-test
  type: exitcode-stdio-1.0
  main-is: Main.hs
  build-depends:
    base,
    QuickCheck >= 2.14,
    fuzzer
  hs-source-dirs: test
  default-language: Haskell2010
  ghc-options: -Wall -O2 -threaded
