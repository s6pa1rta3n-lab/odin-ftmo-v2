[Unit]
Description=FTMO EURUSD Asian crawl-back (CRAWLBACK_EURUSD_ASIA) — armed only when CRAWL_ARMED=1
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=solveetcoagula
WorkingDirectory=/home/solveetcoagula/ftmo-crawlback
# Default disarmed. To arm for session: set CRAWL_ARMED=1 (drop-in or edit), then restart.
Environment=CRAWL_ARMED=0
Environment=CRAWL_KILL=0
# One-shot Ops proof ONLY — run manually with CRAWL_TEST_ORDER=1; do NOT leave =1 here.
# Example: CRAWL_TEST_ORDER=1 CRAWL_ARMED=0 /usr/bin/python3 .../crawlback_eurusd_asia.py
# Environment=CRAWL_TEST_ORDER=0
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/solveetcoagula/ftmo-crawlback/crawlback_eurusd_asia.py
Restart=on-failure
RestartSec=20

[Install]
WantedBy=multi-user.target
