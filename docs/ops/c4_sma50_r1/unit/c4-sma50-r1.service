# Record-only snapshot of the live unit on matt-berserker. Do not install from this repository.
# Live state verified by Trading Ops 2026-10-07 (systemctl show): Environment=C4_ARMED=1,
# service active + enabled. An earlier pre-arm capture carried C4_ARMED=0; this file
# reflects the armed live unit.

[Unit]
Description=Candidate 4 BTCUSD SMA50 R=1 (C4_SMA50_R1) — armed only when C4_ARMED=1
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=solveetcoagula
WorkingDirectory=/home/solveetcoagula/ftmo-c4
Environment=C4_ARMED=1
Environment=C4_KILL=0
Environment=C4_VOLUME=0.01
Environment=C4_INITIAL_EQUITY=100000
ExecStart=/usr/bin/python3 /home/solveetcoagula/ftmo-c4/c4_sma50_r1.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
